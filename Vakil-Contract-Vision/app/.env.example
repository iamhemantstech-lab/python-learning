# =============================================================================
# Vakil-Contract-Vision Environment Template
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# MongoDB Connection URI (Default Docker Compose setup on localhost:27017)
MONGODB_URI=mongodb://root:mypassword@localhost:27017

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
